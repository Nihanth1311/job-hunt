{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev-local-db",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "DATABASE_URL": "",
        "GOOGLE_CLIENT_ID": "",
        "GOOGLE_CLIENT_SECRET": ""
      },
      "port": 3000
    },
    {
      "name": "start-local-db",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3002"
      ],
      "env": {
        "DATABASE_URL": "",
        "GOOGLE_CLIENT_ID": "",
        "GOOGLE_CLIENT_SECRET": "",
        "SCHEDULER": "off"
      },
      "port": 3002
    }
  ]
}