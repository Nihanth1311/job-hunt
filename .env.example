# Copy this file to ".env" and fill in what you need. Never commit .env.
# Use PERSONAL accounts only for every key below.

# --- Sign-in (Google, invite only) ---
# Your Gmail: the admin. You invite everyone else from the People page. Comma-separate for more admins.
ADMIN_EMAIL=
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application). See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required. At least 32 random characters; also encrypts everyone's saved API keys, so never change it afterwards.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Maximum number of people (default 15).
MAX_USERS=20
# How urgently Apple/Google deliver phone notifications: normal (default) or high.
# PUSH_URGENCY=normal

# --- Database ---
# Leave empty to use the built-in database stored in ./data (free, zero setup).
# Set to a PostgreSQL URL when you deploy or want to scale, e.g. postgres://user:pass@host:5432/jobhunt
DATABASE_URL=

# --- API keys ---
# Not here any more: each person adds their own Google Jobs (JSearch) and Telegram keys in
# Settings -> Your API keys. They're stored encrypted per person.

# --- Background jobs ---
# "on": the server checks for new jobs on its own (laptop, VM, Docker). "off": use /api/cron/fetch instead (serverless hosts).
SCHEDULER=on
# Only needed if an external cron calls /api/cron/fetch (send header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Public address of your site, used for links in Telegram messages, e.g. https://myjobs.duckdns.org
APP_URL=

# Don't send anonymous usage data to Next.js
NEXT_TELEMETRY_DISABLED=1

# --- Only for the Docker deployment (docker-compose.yml) ---
# Password for the PostgreSQL container. Letters and numbers only.
POSTGRES_PASSWORD=
# Your free domain, e.g. myjobs.duckdns.org (Caddy uses it to get HTTPS automatically)
DOMAIN=
